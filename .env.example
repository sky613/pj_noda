# 브라우저와 서버 모두에서 쓰는 Supabase 공개 URL (브라우저 기준)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Docker 컨테이너 안의 Next 서버가 Supabase에 닿는 주소 (옵션)
SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
# 서버 전용. 계정 삭제·즉시 삭제에 사용. 브라우저로 절대 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
# 냉각·삭제 기간 표시 단위: days | minutes (DB의 app_config.time_unit과 맞춘다)
RITUAL_TIME_UNIT=days
# 매직링크 리다이렉트 기준 주소 (브라우저 기준)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
